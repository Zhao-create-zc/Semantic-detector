{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zhao-create-zc/Semantic-detector/raw/main/schemas/benchmark_manifest.schema.json",
  "title": "Semantic Detector benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "protocol",
    "dataset",
    "input",
    "ground_truth",
    "config",
    "reporting"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "message_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "license_or_terms",
        "retrieved_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license_or_terms": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "redistributable": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "upstream_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_blob_sha1": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages_jsonl",
        "message_count"
      ],
      "properties": {
        "messages_jsonl": {
          "type": "string",
          "minLength": 1
        },
        "message_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "field_count",
        "method"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "field_count": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_metrics",
        "error_analysis"
      ],
      "properties": {
        "required_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "error_analysis": {
          "type": "boolean"
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_detector_version",
        "git_commit",
        "python_version"
      ],
      "properties": {
        "semantic_detector_version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "github_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
